  "metadata": {
    "version": "1.0",
    "last_updated": "2025-01-24",
    "description": "Practice types configuration file. Add new practice types here and they will automatically appear in the practice hub."
  },
  "instructions": {
    "adding_new_practice": [
      "1. Add a new object to the practice_types array",
      "2. Set a unique id (kebab-case)",
      "3. Define title, description, and icon (emoji or image path)",
      "4. Set the route where this practice is accessed",
      "5. Choose a badge: Core, Popular, Premium, New",
      "6. Set badge_type: default, premium, or new",
      "7. Set is_active to true to make it visible",
      "8. Set requires_premium if needed",
      "9. Set order_index to control display order",
      "10. Configure stats_config to define which stats to display"
    ],
    "badge_types": {
      "default": "Gold color for core features",
      "premium": "Bright gold for premium features",
      "new": "Green color for new features"
    },
    "stats_sources": [
      "attraction_technique_sessions",
      "speech_sessions",
      "challenges",
      "lessons",
      "custom_table_name"
    ],
    "stats_calculations": [
      "count - Count total records",
      "average - Average score/value",
      "sum_duration - Sum of time spent",
      "static - Use hardcoded value"
    ]
  }
}
